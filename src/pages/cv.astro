---
import '../styles/global.css';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CV – Said Carrillo</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        font-family: 'Inter', system-ui, sans-serif;
        background: #f8fafc;
        color: #1e293b;
        font-size: 14px;
        line-height: 1.6;
      }

      .page {
        max-width: 820px;
        margin: 2rem auto;
        background: #ffffff;
        box-shadow: 0 4px 24px rgba(0,0,0,0.08);
        border-radius: 12px;
        overflow: hidden;
      }

      /* ── Header ── */
      .cv-header {
        background: #0f172a;
        color: #f1f5f9;
        padding: 2.5rem 3rem;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 2rem;
        flex-wrap: wrap;
      }

      .cv-header h1 {
        font-size: 2rem;
        font-weight: 800;
        color: #ffffff;
        letter-spacing: -0.02em;
        line-height: 1.2;
      }

      .cv-header .title {
        color: #22d3ee;
        font-size: 1rem;
        font-weight: 500;
        margin-top: 0.4rem;
      }

      .contact-list {
        list-style: none;
        font-size: 0.82rem;
        color: #94a3b8;
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        text-align: right;
      }

      .contact-list a {
        color: #94a3b8;
        text-decoration: none;
      }

      .contact-list a:hover { color: #22d3ee; }

      /* ── Body ── */
      .cv-body {
        display: grid;
        grid-template-columns: 1fr 280px;
        gap: 0;
      }

      @media (max-width: 640px) {
        .cv-header {
          flex-direction: column;
          padding: 1.75rem 1.5rem;
          gap: 1rem;
        }

        .contact-list { text-align: left; }

        .cv-body {
          grid-template-columns: 1fr;
        }

        .cv-main {
          padding: 1.25rem 1.5rem;
          border-right: none;
          border-bottom: 1px solid #f1f5f9;
        }

        .cv-sidebar {
          padding: 1.25rem 1.5rem;
        }

        .print-bar {
          padding: 0.75rem 1.5rem;
          border-radius: 0;
        }
      }

      .cv-main {
        padding: 2rem 2.5rem;
        border-right: 1px solid #f1f5f9;
      }

      .cv-sidebar {
        padding: 2rem 1.75rem;
        background: #f8fafc;
      }

      /* ── Sections ── */
      .section { margin-bottom: 2rem; }

      .section:last-child { margin-bottom: 0; }

      .section-title {
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #22d3ee;
        font-family: 'JetBrains Mono', monospace;
        margin-bottom: 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid #e2e8f0;
      }

      /* ── Resumen ── */
      .summary {
        color: #475569;
        font-size: 0.88rem;
        line-height: 1.7;
      }

      /* ── Proyectos ── */
      .project { margin-bottom: 1.4rem; }
      .project:last-child { margin-bottom: 0; }

      .project-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 0.5rem;
        flex-wrap: wrap;
        margin-bottom: 0.25rem;
      }

      .project-name {
        font-weight: 700;
        font-size: 0.9rem;
        color: #0f172a;
      }

      .project-link {
        font-size: 0.75rem;
        color: #22d3ee;
        text-decoration: none;
        font-family: 'JetBrains Mono', monospace;
      }

      .project-subtitle {
        font-size: 0.75rem;
        color: #64748b;
        margin-bottom: 0.35rem;
        font-style: italic;
      }

      .project-desc {
        font-size: 0.82rem;
        color: #475569;
        line-height: 1.6;
        margin-bottom: 0.5rem;
      }

      .tech-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.3rem;
      }

      .tag {
        font-size: 0.7rem;
        font-family: 'JetBrains Mono', monospace;
        background: #f1f5f9;
        color: #0e7490;
        border: 1px solid #e0f2fe;
        padding: 0.15rem 0.5rem;
        border-radius: 4px;
      }

      /* ── Skills ── */
      .skill-group { margin-bottom: 1.2rem; }
      .skill-group:last-child { margin-bottom: 0; }

      .skill-category {
        font-size: 0.72rem;
        font-weight: 600;
        color: #0f172a;
        margin-bottom: 0.4rem;
      }

      .skill-items {
        display: flex;
        flex-wrap: wrap;
        gap: 0.3rem;
      }

      .skill-item {
        font-size: 0.72rem;
        background: #e0f2fe;
        color: #0369a1;
        border-radius: 4px;
        padding: 0.15rem 0.45rem;
        font-family: 'JetBrains Mono', monospace;
      }

      /* ── Idiomas / Soft skills ── */
      .list-plain {
        list-style: none;
        font-size: 0.82rem;
        color: #475569;
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
      }

      .exp-list {
        list-style: none;
        font-size: 0.8rem;
        color: #475569;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        margin-bottom: 0.5rem;
      }

      .exp-list li::before {
        content: "▸ ";
        color: #22d3ee;
        font-size: 0.7rem;
      }

      .group-label {
        font-size: 0.72rem;
        font-weight: 600;
        color: #64748b;
        margin: 1.1rem 0 0.6rem;
      }

      .list-plain li::before {
        content: "▸ ";
        color: #22d3ee;
        font-size: 0.7rem;
      }

      /* ── Print button ── */
      .print-bar {
        background: #0f172a;
        padding: 0.75rem 3rem;
        display: flex;
        justify-content: flex-end;
        gap: 1rem;
        border-radius: 0 0 12px 12px;
      }

      .btn-print {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1.25rem;
        background: #22d3ee;
        color: #0f172a;
        font-weight: 700;
        font-size: 0.82rem;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        font-family: 'Inter', sans-serif;
        text-decoration: none;
        transition: background 0.2s;
      }

      .btn-print:hover { background: #67e8f9; }

      .btn-back {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1.25rem;
        border: 1px solid #334155;
        color: #94a3b8;
        font-size: 0.82rem;
        border-radius: 8px;
        cursor: pointer;
        font-family: 'Inter', sans-serif;
        text-decoration: none;
        transition: border-color 0.2s, color 0.2s;
      }

      .btn-back:hover { border-color: #22d3ee; color: #22d3ee; }

      /* ── Print styles ── */
      @media print {
        body { background: white; font-size: 12px; }

        .page {
          margin: 0;
          box-shadow: none;
          border-radius: 0;
          max-width: 100%;
        }

        .print-bar { display: none; }

        .cv-header { padding: 1.5rem 2rem; }

        .cv-main { padding: 1.25rem 1.75rem; }
        .cv-sidebar { padding: 1.25rem 1.25rem; }

        .project { margin-bottom: 1rem; }
        .section { margin-bottom: 1.25rem; }

        a { color: inherit !important; text-decoration: none !important; }
        .project-link { color: #0e7490 !important; }
      }

      @page {
        margin: 0.5cm;
        size: A4;
      }
    </style>
  </head>
  <body>
    <div class="page">

      <!-- HEADER -->
      <header class="cv-header">
        <div>
          <h1>Said Carrillo</h1>
          <p class="title">Full Stack Developer · Web &amp; Mobile</p>
          <p style="color:#94a3b8;font-size:0.82rem;margin-top:0.3rem;">Ibarra, Ecuador · Tecnólogo Superior en Desarrollo de Software</p>
        </div>
        <ul class="contact-list">
          <li><a href="mailto:saidcarrillo.job@gmail.com">saidcarrillo.job@gmail.com</a></li>
          <li><a href="https://www.linkedin.com/in/saidCarrillo/" target="_blank">linkedin.com/in/saidCarrillo</a></li>
          <li><a href="https://github.com/saidscv23" target="_blank">github.com/saidscv23</a></li>
          <li><a href="https://saidscv.vercel.app/" target="_blank">saidscv.vercel.app</a></li>
        </ul>
      </header>

      <!-- BODY: main + sidebar -->
      <div class="cv-body">

        <!-- MAIN -->
        <div class="cv-main">

          <!-- Resumen -->
          <div class="section">
            <p class="section-title">Perfil Profesional</p>
            <p class="summary">
              Desarrollador Full Stack con experiencia en aplicaciones web y móviles, sistemas
              empresariales y <strong>facturación electrónica integrada con el SRI</strong>.
              Trabajo con Laravel, Flutter y MySQL, y administro servidores, hosting, dominios y
              bases de datos en producción. Creador de <strong>Z7Firma</strong>, mi plataforma
              propia de facturación electrónica.
            </p>
          </div>

          <!-- Experiencia -->
          <div class="section">
            <p class="section-title">Experiencia</p>
            <div class="project">
              <div class="project-header">
                <span class="project-name">Desarrollador Full Stack – Hardsoft Ecuador</span>
                <span class="project-link">Actual</span>
              </div>
              <ul class="exp-list">
                <li>Mantenimiento de sistemas de facturación electrónica para ~90 clientes: integración con el SRI, XML, PDF-RIDE y autorización de comprobantes.</li>
                <li>Desarrollo completo de las apps móviles RAVER y Mi CanchaYa.</li>
                <li>Principal contribuidor (+110 commits) de la intranet de gestión de clientes en Laravel 12.</li>
                <li>Desarrollo y mantenimiento de aplicaciones web: nuevas funcionalidades, optimización, corrección de errores y pruebas.</li>
                <li>Administración de hosting, cPanel, dominios, Apache, IIS, bases de datos y despliegues.</li>
                <li>Mantenimiento de webs institucionales, monitoreo, soporte e incidencias.</li>
              </ul>
            </div>
          </div>

          <!-- Proyectos -->
          <div class="section">
            <p class="section-title">Proyectos Destacados</p>

            <div class="project">
              <div class="project-header">
                <span class="project-name">🧾 Z7Firma – Proyecto propio</span>
                <a href="https://www.z7firma.com" class="project-link">z7firma.com ↗</a>
              </div>
              <p class="project-subtitle">Plataforma de facturación electrónica para Ecuador (SaaS)</p>
              <p class="project-desc">
                Emisión de comprobantes electrónicos integrada con el SRI, gestión de clientes,
                establecimientos y puntos de emisión, reportes de ventas, planes y suscripciones.
              </p>
              <div class="tech-tags">
                <span class="tag">SRI</span>
                <span class="tag">XML</span>
                <span class="tag">PDF-RIDE</span>
                <span class="tag">Suscripciones</span>
              </div>
            </div>

            <div class="project">
              <div class="project-header">
                <span class="project-name">🗂️ Intranet de Gestión de Clientes</span>
              </div>
              <p class="project-subtitle">Proyecto de Hardsoft Ecuador · Principal contribuidor (+110 commits)</p>
              <p class="project-desc">
                Intranet en Laravel 12 para gestionar clientes, facturación, pagos, licencias y servicios
                web, con dashboard de alertas de vencimiento, control de acceso por roles, tablas
                optimizadas del lado del servidor y una arquitectura basada en Services y Form Requests.
              </p>
              <div class="tech-tags">
                <span class="tag">Laravel 12</span>
                <span class="tag">PHP 8.2</span>
                <span class="tag">MySQL</span>
                <span class="tag">Tailwind</span>
                <span class="tag">Alpine.js</span>
                <span class="tag">DataTables</span>
              </div>
            </div>

            <div class="project">
              <div class="project-header">
                <span class="project-name">🎉 RAVER – App de eventos y lugares</span>
                <a href="https://raverapp.com/" class="project-link">raverapp.com ↗</a>
              </div>
              <p class="project-subtitle">Proyecto de Hardsoft Ecuador · Desarrollo completo</p>
              <p class="project-desc">
                Descubrimiento de bares, discotecas y eventos con mapa interactivo, geolocalización,
                reportes comunitarios, votaciones y sorteos.
              </p>
              <div class="tech-tags">
                <span class="tag">Flutter</span>
                <span class="tag">Laravel</span>
                <span class="tag">MySQL</span>
                <span class="tag">API REST</span>
              </div>
            </div>

            <div class="project">
              <div class="project-header">
                <span class="project-name">🏐 Mi CanchaYa – App de Ecuavóley</span>
                <a href="https://micanchaya.hardsoftecuador.com/" class="project-link">micanchaya.hardsoftecuador.com ↗</a>
              </div>
              <p class="project-subtitle">Proyecto de Hardsoft Ecuador · Desarrollo completo · Google Play</p>
              <p class="project-desc">
                Marcador, gestión de partidos, equipos, jugadores, historial y estadísticas desde el celular.
              </p>
              <div class="tech-tags">
                <span class="tag">Flutter</span>
                <span class="tag">Firebase</span>
              </div>
            </div>

            <p class="group-label">Otros proyectos</p>

            <div class="project">
              <div class="project-header">
                <span class="project-name">🛒 NEXASTORE – Plataforma de ventas</span>
              </div>
              <p class="project-desc">Productos, inventario, clientes, ventas y reportes.</p>
              <div class="tech-tags">
                <span class="tag">PHP</span>
                <span class="tag">JavaScript</span>
                <span class="tag">MySQL</span>
                <span class="tag">MVC</span>
                <span class="tag">AdminLTE</span>
              </div>
            </div>

            <div class="project">
              <div class="project-header">
                <span class="project-name">🍽️ Sistema para restaurante y 🏢 Sistema empresarial Laravel</span>
              </div>
              <p class="project-desc">Pedidos, cocina y reportes con AJAX; clientes, facturación y pagos con Laravel y Blade.</p>
              <div class="tech-tags">
                <span class="tag">PHP</span>
                <span class="tag">Laravel</span>
                <span class="tag">MySQL</span>
                <span class="tag">jQuery</span>
              </div>
            </div>

            <div class="project">
              <div class="project-header">
                <span class="project-name">🌐 Livingood y Electrovolt – Sitios web</span>
                <span>
                  <a href="https://livingood.xo.je" class="project-link">livingood.xo.je ↗</a>
                  <a href="https://electrovolt.xo.je" class="project-link">electrovolt.xo.je ↗</a>
                </span>
              </div>
              <div class="tech-tags">
                <span class="tag">HTML</span>
                <span class="tag">CSS</span>
                <span class="tag">Tailwind</span>
                <span class="tag">JavaScript</span>
              </div>
            </div>

          </div>
        </div>

        <!-- SIDEBAR -->
        <div class="cv-sidebar">

          <!-- Habilidades técnicas -->
          <div class="section">
            <p class="section-title">Habilidades</p>

            <div class="skill-group">
              <p class="skill-category">Backend</p>
              <div class="skill-items">
                <span class="skill-item">PHP</span>
                <span class="skill-item">Laravel</span>
                <span class="skill-item">Node.js</span>
                <span class="skill-item">MVC</span>
                <span class="skill-item">API REST</span>
              </div>
            </div>

            <div class="skill-group">
              <p class="skill-category">Frontend</p>
              <div class="skill-items">
                <span class="skill-item">HTML5</span>
                <span class="skill-item">CSS3</span>
                <span class="skill-item">JavaScript</span>
                <span class="skill-item">Bootstrap</span>
                <span class="skill-item">Tailwind</span>
                <span class="skill-item">Alpine.js</span>
                <span class="skill-item">jQuery</span>
                <span class="skill-item">AJAX</span>
                <span class="skill-item">Blade</span>
              </div>
            </div>

            <div class="skill-group">
              <p class="skill-category">Móvil</p>
              <div class="skill-items">
                <span class="skill-item">Flutter</span>
                <span class="skill-item">Firebase</span>
              </div>
            </div>

            <div class="skill-group">
              <p class="skill-category">Facturación electrónica</p>
              <div class="skill-items">
                <span class="skill-item">SRI</span>
                <span class="skill-item">XML</span>
                <span class="skill-item">PDF-RIDE</span>
              </div>
            </div>

            <div class="skill-group">
              <p class="skill-category">Bases de datos</p>
              <div class="skill-items">
                <span class="skill-item">MySQL</span>
                <span class="skill-item">SQL</span>
                <span class="skill-item">Firebase</span>
              </div>
            </div>

            <div class="skill-group">
              <p class="skill-category">Servidores</p>
              <div class="skill-items">
                <span class="skill-item">Apache</span>
                <span class="skill-item">IIS</span>
                <span class="skill-item">cPanel</span>
                <span class="skill-item">Hosting</span>
                <span class="skill-item">Dominios</span>
                <span class="skill-item">Windows</span>
                <span class="skill-item">Linux</span>
              </div>
            </div>

            <div class="skill-group">
              <p class="skill-category">Herramientas</p>
              <div class="skill-items">
                <span class="skill-item">Git</span>
                <span class="skill-item">GitHub</span>
                <span class="skill-item">VS Code</span>
                <span class="skill-item">PowerShell</span>
              </div>
            </div>
          </div>

          <!-- Fortalezas -->
          <div class="section">
            <p class="section-title">Fortalezas</p>
            <ul class="list-plain">
              <li>Ciclo completo: desarrollo a producción</li>
              <li>Facturación electrónica Ecuador</li>
              <li>Apps web y móviles</li>
              <li>Infraestructura y servidores</li>
              <li>Resolución de incidencias</li>
            </ul>
          </div>

          <!-- Idiomas -->
          <div class="section">
            <p class="section-title">Idiomas</p>
            <ul class="list-plain">
              <li>Español (nativo)</li>
              <li>Inglés (técnico)</li>
            </ul>
          </div>

        </div>
      </div>

      <!-- PRINT BAR -->
      <div class="print-bar">
        <a href="/" class="btn-back">← Volver al portafolio</a>
        <button class="btn-print" onclick="window.print()">
          ⬇ Guardar como PDF
        </button>
      </div>

    </div>
  </body>
</html>
