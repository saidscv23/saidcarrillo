---
const areas = [
  {
    icon: "🧾",
    title: "Facturación electrónica",
    items: [
      "Administración y mantenimiento de sistemas de facturación para ~90 clientes",
      "Integración con los servicios del SRI y cambios normativos",
      "Generación y procesamiento de documentos XML",
      "Representaciones impresas PDF-RIDE",
      "Emisión, validación y autorización de comprobantes",
    ],
  },
  {
    icon: "💻",
    title: "Desarrollo de software",
    items: [
      "Desarrollo de aplicaciones web y móviles",
      "Intranet de gestión de clientes en Laravel 12 (principal contribuidor, +110 commits)",
      "Trabajo en equipo con Git: ramas dev/main y merges",
      "Nuevas funcionalidades y optimización de sistemas existentes",
      "Análisis de requerimientos",
      "Corrección de errores y pruebas",
      "Mantenimiento de aplicaciones en producción",
    ],
  },
  {
    icon: "🖥️",
    title: "Servidores e infraestructura",
    items: [
      "Hosting, cPanel, dominios y subdominios",
      "Entornos Apache e IIS",
      "Despliegue y configuración de aplicaciones",
      "Administración de bases de datos",
      "Diagnóstico de conectividad y monitoreo de servicios",
      "Resolución de errores en producción (403, CORS, caché)",
    ],
  },
  {
    icon: "🛠️",
    title: "Webs institucionales y soporte",
    items: [
      "Mantenimiento y actualización de sitios institucionales",
      "Atención de requerimientos técnicos e incidencias",
      "Documentación de procesos",
      "Planificación de mejoras y actualizaciones",
    ],
  },
];
---
<section id="experiencia" class="py-16 md:py-24 bg-gray-900/30">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="mb-12" data-fade-left>
      <p class="text-cyan-400 font-mono text-sm mb-2">02.</p>
      <h2 class="text-3xl md:text-4xl font-bold text-white">Experiencia</h2>
      <div class="w-12 h-0.5 bg-cyan-400 mt-3"></div>
    </div>

    <div data-fade class="bg-gray-900 border border-gray-800 rounded-2xl p-6 md:p-8">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-8 pb-6 border-b border-gray-800">
        <div>
          <h3 class="text-xl md:text-2xl font-bold text-white">Desarrollador Full Stack</h3>
          <p class="text-cyan-400 font-medium mt-1">Hardsoft Ecuador</p>
        </div>
        <span class="self-start md:self-auto text-xs font-mono text-cyan-400 bg-cyan-400/10 border border-cyan-400/20 px-3 py-1.5 rounded-full">
          Trabajo actual
        </span>
      </div>

      <p class="text-gray-400 leading-relaxed mb-8 max-w-3xl">
        Participo en todo el ciclo de vida de las aplicaciones: desarrollo, implementación,
        operación, mantenimiento y mejora continua de plataformas empresariales e institucionales.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {areas.map((area, i) => (
          <div data-fade style={`--delay: ${i * 0.08}s`} class="bg-gray-950/60 border border-gray-800 rounded-xl p-5 hover:border-cyan-400/30 transition-colors duration-300">
            <div class="flex items-center gap-3 mb-4">
              <span class="text-2xl">{area.icon}</span>
              <h4 class="text-white font-semibold">{area.title}</h4>
            </div>
            <ul class="space-y-2">
              {area.items.map((item) => (
                <li class="flex gap-2 text-sm text-gray-400 leading-relaxed">
                  <span class="text-cyan-400 shrink-0">▸</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
